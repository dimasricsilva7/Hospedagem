// HOSPEDAGEM — plataforma de landing pages para hotéis/resorts (Postgres/Neon).
// Decisões:
//  • admin_profiles do spec virou campo em User (role + passwordChangeRequired) — mais simples.
//  • campaign_sections do spec virou o JSON Campaign.content (dados+ordem+visibilidade das seções):
//    um só ponto de verdade por campanha, editável via formulário. Ver app/lib/content.ts.
//  • Backend Neon+Prisma (não Supabase) — autorização sempre no servidor (RLS do spec = guardas
//    de sessão em app/server/auth.ts; visitante nunca acessa listagem de leads).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED") // conexão direta p/ migrations (Neon pooled quebra advisory lock)
}

enum UserRole {
  ADMIN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum LeadStatus {
  NOVO
  CONTATADO
  NEGOCIACAO
  CONVERTIDO
  DESCARTADO
}

enum ReservationStatus {
  PENDENTE
  EM_ATENDIMENTO
  CONFIRMADA
  CANCELADA
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  role                   UserRole  @default(ADMIN)
  passwordChangeRequired Boolean   @default(false) // troca obrigatória no 1º acesso (seção 7.1)
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  sessions               Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // nunca guardamos o token em claro
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Chave-valor: buckets de rate limit (ver app/server/ratelimit.ts) e flags do app.
model Setting {
  key   String @id
  value Json
}

model Hotel {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  shortCode      String?      // prefixo do número de reserva (ex.: "NANNAI" → NANNAI-482916)
  description    String?
  logoUrl        String?
  primaryColor   String       @default("#0e7490")
  secondaryColor String       @default("#f59e0b")
  whatsapp       String?
  email          String?
  instagram      String?
  facebook       String?
  city           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  campaigns      Campaign[]
  leads          Lead[]
  media          MediaAsset[]
  rooms          Room[]
  reservations   ReservationRequest[]

  @@index([isActive])
}

model Campaign {
  id             String         @id @default(cuid())
  hotelId        String
  name           String
  slug           String
  status         CampaignStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  timezone       String         @default("America/Sao_Paulo")
  content        Json           // CampaignContent — seções, ordem, visibilidade, tema (app/lib/content.ts)
  formConfig     Json           // FormConfig — campos, botão, mensagem, consentimento
  trackingConfig Json           // TrackingConfig — Meta Pixel, GA4, GTM
  reservationConfig Json?        // ReservationConfig — WhatsApp, horários, limites (app/lib/content.ts); null = defaults
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  leads          Lead[]
  media          MediaAsset[]
  reservations   ReservationRequest[]

  @@unique([hotelId, slug]) // URL /{hotel}/{campanha}
  @@index([status])
}

model Lead {
  id           String     @id @default(cuid())
  hotelId      String
  campaignId   String?
  name         String
  email        String?
  phone        String?
  customFields Json?
  consentData  Json? // { marketing: bool, lgpd: bool, at: ISO } — base legal registrada
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  fbclid       String?
  gclid        String?
  landingPage  String?
  status       LeadStatus @default(NOVO)
  notes        String?
  createdAt    DateTime   @default(now())
  hotel        Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  campaign     Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  reservations ReservationRequest[]

  @@index([hotelId, createdAt])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

// Acomodação (quarto) de um hotel. Preços em centavos (nunca float p/ dinheiro).
model Room {
  id                 String   @id @default(cuid())
  hotelId            String
  name               String
  description        String?
  mainImage          String?
  images             Json?    // string[] de URLs (galeria)
  amenities          Json?    // string[] de comodidades
  beds               String?  // ex.: "1 cama de casal + 1 solteiro"
  maxAdults          Int      @default(2)
  maxChildren        Int      @default(0)
  priceOriginalCents Int      @default(0)
  pricePromoCents    Int      @default(0)
  badgeCount         Int?     // "Restam apenas N" — indicador comercial, NÃO estoque real
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  hotel              Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reservations       ReservationRequest[]

  @@index([hotelId, sortOrder])
}

// Solicitação de reserva (status inicial PENDENTE). Guarda uma CÓPIA dos preços/condições
// no momento do pedido — alterações futuras no painel não mudam pedidos antigos.
model ReservationRequest {
  id                 String            @id @default(cuid())
  code               String            @unique // identificador curto p/ o atendimento localizar o pedido
  hotelId            String
  campaignId         String?
  leadId             String?
  roomId             String?
  roomName           String            // snapshot do nome
  guestName          String
  guestCpf           String?           // coletado via WhatsApp; exibido mascarado no voucher
  guestPhone         String?
  guestEmail         String?
  checkIn            String            // "YYYY-MM-DD" (sem fuso, evita drift)
  checkInTime        String
  checkOut           String            // "YYYY-MM-DD"
  checkOutTime       String
  nights             Int
  adults             Int               @default(1)
  children           Int               @default(0)
  childrenAges       Json?             // number[]
  rooms              Int               @default(1)
  priceOriginalCents Int               // snapshot/diária
  pricePromoCents    Int               // snapshot/diária
  discountPercent    Int
  totalOriginalCents Int
  totalPromoCents    Int
  notes              String?
  status             ReservationStatus @default(PENDENTE)
  createdAt          DateTime          @default(now())
  hotel              Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  campaign           Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  room               Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([hotelId, createdAt])
  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model MediaAsset {
  id         String    @id @default(cuid())
  hotelId    String?
  campaignId String?
  fileUrl    String
  fileName   String?
  altText    String?
  mimeType   String?
  createdAt  DateTime  @default(now())
  hotel      Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([campaignId])
}
