# ─── Banco de dados (Neon Postgres) ───────────────────────────────────────────
# Pooled (runtime). No painel da Neon: "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direta (migrations). "Direct connection" — sem -pooler. Neon pooled quebra o advisory lock.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Segredo para assinar/hashear sessões e IPs. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-uma-string-aleatoria-de-32-chars"

# Admin inicial — provisionado automaticamente no 1º acesso ao /admin/login.
# A senha NUNCA é gravada em claro; vira hash scrypt no banco e exige troca no 1º login.
ADMIN_EMAIL="admin@seudominio.com.br"
ADMIN_INITIAL_PASSWORD="@Senha2026!"

# ─── Opcional ─────────────────────────────────────────────────────────────────
# URL pública (para metadata/OG). Na Vercel pode deixar em branco (usa VERCEL_URL).
APP_URL="https://seu-dominio.com.br"
